{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mbe_workload_record_v4.schema.json",
  "title": "MBE Workload Record v4 Layered Scheduling/Runtime Access",
  "type": "object",
  "required": [
    "schema_version", "dataset_id", "source_row_index", "source_event_id",
    "timestamp_ms", "sender_id", "operation_type", "runtime_value", "state_keys",
    "static_access_envelope", "scheduling_access_schema", "scheduling_access_source",
    "scheduling_access_list", "scheduling_access_digest", "access_list_schema",
    "access_list_source", "access_list", "access_list_digest", "routing_source_key"
  ],
  "properties": {
    "schema_version": {"const": "mbe_workload_record_v4"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_row_index": {"type": "integer", "minimum": 0},
    "source_event_id": {"type": "string", "minLength": 1},
    "source_tx_hash": {"type": ["string", "null"]},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "sender_id": {"type": "string", "minLength": 1},
    "receiver_id": {"type": ["string", "null"]},
    "operation_type": {"type": "string", "minLength": 1},
    "runtime_value": {"type": "integer", "minimum": 1},
    "state_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "static_access_envelope": {"type": "object"},
    "scheduling_access_schema": {"type": "string", "minLength": 1},
    "scheduling_access_source": {"type": "string", "minLength": 1},
    "scheduling_access_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schedulingAccessItem"}},
    "scheduling_access_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "access_list_schema": {"type": "string", "minLength": 1},
    "access_list_source": {"type": "string", "minLength": 1},
    "access_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtimeAccessItem"}},
    "access_list_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "routing_source_key": {"type": "string", "minLength": 1},
    "routing_target_key": {"type": ["string", "null"]},
    "skew_keys": {"type": "object"},
    "provenance": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "schedulingAccessItem": {
      "type": "object",
      "required": ["key", "mode", "update_semantics"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "mode": {"enum": ["read", "write", "read_write", "commutative_delta", "unknown"]},
        "update_semantics": {"type": "string", "minLength": 1},
        "delta": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "runtimeAccessItem": {
      "type": "object",
      "required": ["key", "mode", "update_semantics"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "mode": {"enum": ["read", "write", "read_write", "commutative_delta"]},
        "update_semantics": {"type": "string", "minLength": 1},
        "delta": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
